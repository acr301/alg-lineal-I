# https://editorconfig.org — reglas de editor comunes al equipo (Win/macOS/Linux).
# Complementa a .gitattributes (nivel git). El guard de CRLF en CI vive en #27.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,toml}]
indent_size = 4

[*.{md,markdown}]
# Markdown usa dos espacios finales para forzar salto de línea.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab
