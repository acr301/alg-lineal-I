!informes/plantilla/
informes/plantilla/datos.tex
informes/plantilla/img/*
!informes/plantilla/img/.gitkeep
informes/plantilla/*.pdf
informes/plantilla/*.aux
informes/plantilla/*.log
informes/plantilla/*.out
informes/plantilla/*.toc
